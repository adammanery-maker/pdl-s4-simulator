{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDL participant-neutral matchup preparation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "candidateParticipant",
    "opponentParticipant",
    "candidateTeams",
    "opponentTeams"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$" },
    "candidateParticipant": { "$ref": "#/$defs/participant" },
    "opponentParticipant": { "$ref": "#/$defs/participant" },
    "candidateTeams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/team" }
    },
    "opponentTeams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/team" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "draftedTeraTypes", "teraCaptains", "roster"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "draftedTeraTypes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "teraCaptains": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "roster": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["species", "cost"],
            "properties": {
              "species": { "type": "string", "minLength": 1 },
              "cost": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "teamPath"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "teamPath": { "type": "string", "minLength": 1 },
        "teamHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
